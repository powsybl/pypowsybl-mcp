# Project environment configuration
# Copy this file as needed and fill in the secrets/values for your environment.
# Do NOT commit real secrets to version control.
# ------------------------
# Misc
# ------------------------
# CUDA devices selection for scheduled jobs, e.g., "0", "0,1" or empty for CPU
CUDA_VISIBLE_DEVICES=0,1

# ------------------------------------------------------------------------------
# MCP SERVICE DISCOVERY ADDRESS
# The hostname or IP address embedded in MCP-generated resources.
# - IMPORTANT: Ensure this address is routable from your LLM's environment.
# - Default: Automatically detected local IP (best for local-only setups).
# ------------------------------------------------------------------------------
MCP_PORT=9992
#MCP_PUBLIC_ADDRESS=http://192.168.1.50:9992
#MCP_PUBLIC_ADDRESS=https://pypowsybl-mcp.mydomain.com
#MCP_PUBLIC_ADDRESS=http://localhost:9992

# HTTPS certificate verification for URL downloads (`load_network_from_url`)
# false/no/0/off/disabled = accept self-signed/untrusted certificates (default)
# true/yes/1/on/enabled = enforce certificate validation
# Any other value is treated as disabled and logged as a warning.
MCP_VERIFY_SSL=false

# ------------------------
# Docker configuration
# ------------------------
# UID/GID of the user on the host (run `id -u` and `id -g`)
# to ensure the container has correct permissions for mounted volumes
HOST_UID=1000
HOST_GID=1000

# ------------------------
# OpenAI / LLM configuration
# ------------------------
# Standard OpenAI-compatible settings
OPENAI_API_KEY=
# If using Azure OpenAI or other compatible endpoints
OPENAI_BASE_URL=
# Default model used across demos/agents (e.g., gpt-4.1-mini, gpt-5, mistral-medium, etc.)
OPENAI_DEFAULT_MODEL=gpt-5.1
# Timeout for answers in seconds
AI_TIMEOUT=90

# Token used to prevent the access of some tools from the LLM (trick!)
# The value below is an example only — replace it with your own random secret before deploying.
MCP_AUTH_TOKEN=abcdefghijklmnopqrstuvwxzy0123456789abcdefghijklmnopqrstuvwxzy01

#-----------------------------
# Others
#-----------------------------
LOG_DIR=logs
#-----------------------------
# Pagination
#-----------------------------
# How many items we return per page when the client omits limit, or sends 0 or a negative value
DEFAULT_PAGINATION_LIMIT=100
# Largest page size a single request is allowed to ask for
MAX_PAGINATION_LIMIT=1000